#include <iostream>
using namespace std;

#define MAX 100

class Stack {
    int arr[MAX];
    int top;

public:
    Stack() {
        top = -1;
    }

    void push(char x) {
        if (top == MAX - 1)
            cout << "Stack Overflow";
        else
            arr[++top] = x;
    }

    char pop() {
        if (top == -1)
            return '\0';
        return arr[top--];
    }
};

int main() {
    string str;
    Stack s;

    cout << "Enter a string: ";
    cin >> str;

    // Push all characters into stack
    for (int i = 0; i < str.length(); i++) {
        s.push(str[i]);
    }

    // Compare original string with popped characters
    bool palindrome = true;

    for (int i = 0; i < str.length(); i++) {
        if (str[i] != s.pop()) {
            palindrome = false;
            break;
        }
    }

    if (palindrome)
        cout << "Palindrome";
    else
        cout << "Not Palindrome";

    return 0;
}c
